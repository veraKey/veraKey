# Copy to .env (never commit .env). Testnet hot keys only: never reuse them on mainnet.
# scripts/deploy.sh and `pnpm start` read this file; on a hosting provider, set the server variables
# in its dashboard instead.

# --- scripts/deploy.sh sepolia -------------------------------------------------------------------
# Deploys the verifier, the account implementation and the factory. Needs >= 0.01 Arbitrum Sepolia ETH.
DEPLOYER_PRIVATE_KEY=
# The https origin that serves the app and its WebAuthn rpId (the origin's host or a parent domain),
# e.g. https://verakey.example.com and verakey.example.com. The factory binds every account to both
# for good: a new domain needs a new deployment.
VERAKEY_ORIGIN=
VERAKEY_RP_ID=
# Optional: a keyed provider URL. deploy.sh uses it but never writes it to deployments/.
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
# Optional: Paxos USDG on Arbitrum Sepolia (the default) and demo policy overrides.
USDG_ADDRESS=0xFFC95faa3d63Cde504a05B567C600B78C0b41892
# VERAKEY_PER_TX_CAP=10000000       # 10 USDG, in 6-decimal base units
# VERAKEY_DAILY_CAP=25000000        # 25 USDG
# VERAKEY_CHANGE_DELAY=120          # seconds; production default 86400
# VERAKEY_RECOVERY_DELAY=300        # seconds; production default 259200

# --- server: pnpm start, or the Docker image -----------------------------------------------------
VERAKEY_NETWORK=sepolia
# Signs every relayed transaction. Fund it with Arbitrum Sepolia ETH for gas and with USDG for the
# demo faucet, which sends 5 USDG to each new account (claim USDG at https://faucet.paxos.com).
RELAYER_PRIVATE_KEY=
# Optional: the node the relayer and the browser's /api/rpc proxy use (default: the deployment's RPC).
# RELAYER_RPC_URL=
# Optional: relayer fee and faucet amount in USDG base units (defaults 20000 = 0.02 and 5000000 = 5).
# RELAYER_FEE_USDG_UNITS=20000
# FAUCET_USDG_UNITS=5000000
# Optional: where the faucet records funded accounts (default ./data; /data in the Docker image).
# VERAKEY_DATA_DIR=
# PORT=3090
# Behind a tunnel (cloudflared) or reverse proxy on the same machine, listen on loopback only.
# HOST=127.0.0.1
