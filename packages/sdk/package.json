{
  "name": "@verakey/sdk",
  "version": "0.1.0",
  "description": "VeraKey SDK: passkey (WebAuthn + PRF) authentication proven in zero knowledge, verified by Stylus smart accounts on Arbitrum.",
  "keywords": [
    "passkey",
    "webauthn",
    "zero-knowledge",
    "noir",
    "ultrahonk",
    "arbitrum",
    "stylus",
    "smart-account",
    "sign-in",
    "usdg"
  ],
  "homepage": "https://verakey.mdloglabs.org/docs/build/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veraKey/veraKey.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "prepublishOnly": "node scripts/publish-guard.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json",
    "vectors": "node scripts/gen-test-vectors.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aztec/bb.js": "5.2.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@noir-lang/noir_js": "1.0.0-beta.25",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.4"
  }
}
