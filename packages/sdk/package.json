    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260522",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@noir-lang/noir_js": "1.0.0-beta.22",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "^2.1.4"
  }
}
