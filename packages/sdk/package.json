{
  "name": "@verakey/sdk",
  "version": "0.1.0",
  "description": "VeraKey SDK: passkey (WebAuthn + PRF) authentication proven in zero knowledge, verified by Stylus smart accounts on Arbitrum.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json",
